[TEMPLATE]
# ---- Copy to .env and fill in. NEVER commit real secrets. ----

# Application
APP_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Database: SQLite by default (file created automatically).
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/healthcare
DATABASE_URL=sqlite:///./data/platform.db

# Mock EHR service (separate process + separate database)
MOCK_EHR_URL=http://127.0.0.1:8001
MOCK_EHR_DATABASE_URL=sqlite:///./data/mock_ehr.db
MOCK_EHR_API_KEY=change-me-ehr-key
MOCK_EHR_TIMEOUT_SECONDS=5
EHR_MODE=mock

# Fault injection (Mock EHR; deterministic, OFF by default)
# Modes: none | server_error | timeout | rejected | delay
# "timeout" sleeps MOCK_EHR_FAULT_DELAY_SECONDS then processes normally --
# that is what creates the Phase 4 "unknown outcome" situation.
MOCK_EHR_FAULT_MODE=none
MOCK_EHR_FAULT_DELAY_SECONDS=10

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720

# AI providers - Gemini is the primary LLM (GEMINI_API_KEY required for voice);
# Groq is an optional LLM/STT fallback and is never required.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Voice (Phase 7) - Gemini-first: STT uses GEMINI_API_KEY audio understanding,
# TTS uses gemini-2.5-flash-preview-tts. STT_PROVIDER=groq selects Whisper.
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash
WHISPER_MODEL=whisper-large-v3-turbo
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE_NAME=Zephyr

# Frontend (Streamlit)
API_BASE_URL=http://127.0.0.1:8000
